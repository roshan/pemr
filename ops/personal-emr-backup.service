[Unit]
Description=personal-emr nightly backup
After=personal-emr.service postgres.service
Wants=personal-emr.service postgres.service

[Service]
Type=oneshot
ExecStart=%h/.local/bin/personal-emr-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=default.target
